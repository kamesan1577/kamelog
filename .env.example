# Canonical public origin for WebAuthn, URLs and ActivityPub domain.
KAMELOG_ORIGIN=http://localhost:3000
KAMELOG_DATA_DIR=.runtime
# Production Compose normally keeps the SQLite/media volume on SSD.
# For an explicit cold-storage migration, select the prepared bind volume:
# KAMELOG_DATA_VOLUME=kamelog-data-hdd
# KAMELOG_DATA_HOST_DIR=/mnt/storage/kamelog-data
# Keep backups separate from the live volume; the host installer accepts
# KAMELOG_BACKUP_ROOT=/mnt/storage/backups/kamelog.
# Set a random one-time value of at least 32 characters OUTSIDE Git.
KAMELOG_BOOTSTRAP_TOKEN=
