[Unit]
Description=Deploy the latest CI-approved kamelog release
After=network-online.target docker.service kamelog.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=kamelog
Group=kamelog
SupplementaryGroups=docker
ExecStart=/usr/local/sbin/kamelog-update
TimeoutStartSec=20min
Nice=10

[Install]
WantedBy=multi-user.target
