[Unit]
Description=Connect eligible kamelog tweets with Jev
After=docker.service kamelog.service
Wants=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=kamelog
Group=kamelog
SupplementaryGroups=docker
WorkingDirectory=/srv/kamelog
ExecStart=/usr/bin/docker compose --env-file /etc/kamelog/env -f /srv/kamelog/compose.yaml run --rm --no-deps app-blue node scripts/auto-thread.ts
TimeoutStartSec=20min
Nice=15
