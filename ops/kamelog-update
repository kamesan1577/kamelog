#!/usr/bin/env bash
set -Eeuo pipefail
APP_DIR="${KAMELOG_APP_DIR:-/srv/kamelog}"
ENV_FILE="${KAMELOG_ENV_FILE:-/etc/kamelog/env}"
BACKUP_ROOT="${KAMELOG_BACKUP_ROOT:-/var/backups/kamelog}"
STATE_DIR="${KAMELOG_DEPLOY_STATE_DIR:-/var/lib/kamelog-deploy}"
HEALTH_URL="${KAMELOG_HEALTH_URL:-http://127.0.0.1:3000/api/health}"
REPOSITORY="${KAMELOG_GITHUB_REPOSITORY:-kamesan1577/kamelog}"
BRANCH="${KAMELOG_DEPLOY_BRANCH:-main}"
WORKFLOW="${KAMELOG_DEPLOY_WORKFLOW:-ci.yml}"
LOCK_FILE="${KAMELOG_DEPLOY_LOCK:-/run/lock/kamelog-update.lock}"
MIN_FREE_KIB="${KAMELOG_DEPLOY_MIN_FREE_KIB:-10485760}"
log() { printf '%s %s\n' "$(date --iso-8601=seconds)" "$*"; }
fail() { log "ERROR: $*"; exit 1; }
for command in curl docker flock git node; do command -v "$command" >/dev/null || fail "required command is missing: $command"; done
exec 9>"$LOCK_FILE"
flock -n 9 || { log "another deployment is running"; exit 0; }
test -d "$APP_DIR/.git" || fail "not a Git checkout: $APP_DIR"
test -r "$ENV_FILE" || fail "environment file is not readable: $ENV_FILE"
mkdir -p "$BACKUP_ROOT" "$STATE_DIR"
cd "$APP_DIR"
test -z "$(git status --porcelain --untracked-files=no)" || fail "tracked files in the production checkout were modified"
free_kib="$(df -Pk "$APP_DIR" | awk 'NR == 2 {print $4}')"
test "$free_kib" -ge "$MIN_FREE_KIB" || fail "less than $MIN_FREE_KIB KiB is free; prune reviewed build cache before deploying"
remote_sha="$(git ls-remote origin "refs/heads/$BRANCH" | awk 'NR == 1 {print $1}')"
test "$remote_sha" || fail "could not resolve origin/$BRANCH"
runs_url="https://api.github.com/repos/$REPOSITORY/actions/workflows/$WORKFLOW/runs?branch=$BRANCH&event=push&status=success&per_page=1"
ci_sha="$(curl --fail --silent --show-error --location --header 'Accept: application/vnd.github+json' --header 'X-GitHub-Api-Version: 2022-11-28' --user-agent 'kamelog-pull-deployer' "$runs_url" | node --input-type=module -e '
let input=""; process.stdin.setEncoding("utf8"); process.stdin.on("data",c=>input+=c); process.stdin.on("end",()=>{const r=JSON.parse(input).workflow_runs?.[0]; if(r?.status==="completed"&&r?.conclusion==="success"&&r?.event==="push")process.stdout.write(r.head_sha);});')"
test "$ci_sha" || fail "GitHub returned no successful push CI run"
if test "$remote_sha" != "$ci_sha"; then log "origin/$BRANCH has not passed CI yet; leaving the running release unchanged"; exit 0; fi
current_sha="$(git rev-parse HEAD)"
if test "$current_sha" = "$remote_sha"; then log "already running $current_sha"; exit 0; fi
git fetch --quiet --no-tags origin "$remote_sha"
git cat-file -e "$remote_sha^{commit}"
compose=(docker compose --env-file "$ENV_FILE" -f "$APP_DIR/compose.yaml")
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
backup_name="$timestamp-${current_sha:0:12}"
previous_image="$("${compose[@]}" images -q app-blue | awk 'NR == 1 {print $1}')"
test "$previous_image" || fail "could not resolve the running app image"
healthcheck_replica() {
  local replica="$1" healthy=0
  for _attempt in $(seq 1 60); do
    if "${compose[@]}" exec -T "$replica" node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"; then healthy=1; break; fi
    sleep 1
  done
  test "$healthy" = 1
}
deploy_replica() {
  local replica="$1"
  log "rolling $replica"
  "${compose[@]}" up -d --no-deps "$replica"
  healthcheck_replica "$replica"
}
restore_previous_release() {
  local failed_status=$?
  trap - ERR
  log "deployment failed; restoring code revision $current_sha"
  docker image tag "$previous_image" kamelog-app:current || true
  deploy_replica app-blue || true
  deploy_replica app-green || true
  "${compose[@]}" up -d --no-deps gateway || true
  git checkout --quiet --detach "$current_sha" || true
  log "rollback attempted; backup retained at $BACKUP_ROOT/$backup_name"
  exit "$failed_status"
}
trap restore_previous_release ERR
log "creating an online SQLite and immutable-media backup"
"${compose[@]}" run --rm --no-deps -v "$BACKUP_ROOT:/backups" app-blue node scripts/admin.mjs backup /data "/backups/$backup_name"
log "deploying CI-approved revision $remote_sha"
git checkout --quiet --detach "$remote_sha"
"${compose[@]}" build app-blue
deploy_replica app-blue
deploy_replica app-green
"${compose[@]}" up -d --no-deps gateway
curl --fail --silent --show-error "$HEALTH_URL" >/dev/null
printf '%s\n' "$remote_sha" >"$STATE_DIR/deployed-sha"
trap - ERR
log "deployment completed: $remote_sha"
